# Pterodactyl panel URL, without a trailing slash.
PteroApi_Url=https://panel.example.com

# Pterodactyl application API key. Used to list servers.
PteroApi_AppKey=ptla_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pterodactyl client API key. Used to send power signals and read server state.
PteroApi_ClientKey=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required NUT server connection.
NUT_ServerIP=192.168.50.10
NUT_ServerPort=3493
NUT_UPS_NAME=ups

# Optional NUT auth. Leave empty if your NUT server does not require login.
NUT_Login=
NUT_Password=

# Agent list. Keep this as one JSON line for dotenv parsing.
# Optional "ptero_node" (Pterodactyl node id or name, or a list such as [3, 4] when one machine hosts several
# Pterodactyl nodes) links the agent to its game servers in the topology view; without it the controller matches
# the node FQDN against the agent ip / hostname. Display only: shutdown always stops every server on the panel.
AgentInfo=[{"name":"Node-1","ip":"192.168.50.101","mac":"AA:BB:CC:DD:EE:FF","port":5858}]

# ---- Control loop (optional, defaults shown) ----
# Seconds between control cycles.
POLL_INTERVAL=30
# Seconds between UPS reads for the live dashboard / history charts.
MONITOR_INTERVAL=5
# Shut nodes down when on battery and battery.charge <= this value.
SHUTDOWN_BATTERY_THRESHOLD=50
# Wait for panel servers to stop: attempts x interval seconds.
SERVER_STOP_MAX_ATTEMPTS=20
SERVER_STOP_CHECK_INTERVAL=5
# Wake-on-LAN rounds x interval seconds after power returns.
WOL_ATTEMPTS=20
WOL_INTERVAL=1
# Print the rich status tables to the console every cycle.
CONSOLE_TABLE=true

# ---- Web UI ----
WEB_ENABLED=true
# Use 0.0.0.0 to open the dashboard to your LAN (set WEB_TOKEN when you do).
WEB_HOST=127.0.0.1
WEB_PORT=8080
# When set, every /api call needs "Authorization: Bearer <token>" (the dashboard asks for it once).
WEB_TOKEN=

# Start in simulation mode (same as --simulate). Never touches real hardware.
SIMULATION=false
